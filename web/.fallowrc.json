{
  "$schema": "./node_modules/fallow/schema.json",
  "duplicates": {
    "minOccurrences": 2
  },
  "health": {
    "maxCyclomatic": 12,
    "maxCognitive": 10,
    "maxUnitSize": 60
  },
  "ignoreDependencies": ["tailwindcss"],
  "audit": {
    "gate": "new-only"
  },
  "rules": {
    "boundary-violation": "error",
    "circular-dependencies": "error",
    "unused-dependencies": "error"
  }
}
