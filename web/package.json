{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "quality": "fallow --format json --fail-on-issues",
    "verify": "npm run generate:api && npm run test && npm run lint && npm run typecheck && npm run quality && npm run build",
    "generate:api": "../scripts/generate-api-client.sh"
  },
  "dependencies": {
    "next": "16.2.12",
    "openapi-fetch": "0.17.0",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "fallow": "^3.10.0",
    "jsdom": "^30.0.1",
    "openapi-typescript": "7.13.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "minimatch": "10.2.6",
    "brace-expansion": "5.0.9",
    "postcss": "8.5.25",
    "sharp": "0.35.3"
  }
}
